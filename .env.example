# Copy to .env.local and fill in. For local development, `npx supabase start` prints these values.

# Public URL of the website (used in email links).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Supabase project URL and publishable (browser-safe) key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. SERVER ONLY: never expose to the browser, never commit.
# Used by admin scripts and tests.
SUPABASE_SECRET_KEY=

# Local test inbox (Mailpit) used by automated tests. Not used in production.
MAILPIT_URL=http://127.0.0.1:54324
