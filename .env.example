# Copy to .env.local and fill in. For local development, `npx supabase start` prints these values.

# Public URL of the website (used in email links).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Supabase project URL and publishable (browser-safe) key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. SERVER ONLY: never expose to the browser, never commit.
# Used by admin scripts and tests.
SUPABASE_SECRET_KEY=

# Optional: support email shown on the Help page to people who can't sign in.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Local test inbox (Mailpit) used by automated tests. Not used in production.
MAILPIT_URL=http://127.0.0.1:54324

# --- Stripe (Phase 4). TEST MODE ONLY until the owner approves live payments. ---
# Secret key from Stripe Dashboard → Developers → API keys (starts with sk_test_). SERVER ONLY.
# In this project's cloud sessions the real key is injected by the network proxy; use a placeholder:
#   STRIPE_SECRET_KEY=sk_test_proxyinjected
STRIPE_SECRET_KEY=
# Webhook signing secrets (whsec_...): one endpoint for the platform account (subscriptions) and,
# optionally, a second for connected accounts (providers' card payments, refunds).
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Safety lock: DoneZo refuses live keys and live events unless this is exactly "true".
STRIPE_ALLOW_LIVE=false
# Tests only: point Stripe at the local simulator (stripe-mock). Leave empty otherwise.
STRIPE_API_HOST=
STRIPE_API_PORT=
STRIPE_API_PROTOCOL=
